{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/**": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...all].js"
    },
    {
      "source": "/peerjs/(.*)",
      "destination": "/api/[...all].js"
    }
  ]
}
